# Copy to .env. Use unique secrets for a real deployment.
POSTGRES_USER=rescueproof
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=rescueproof
DATABASE_URL=postgres://rescueproof:replace-with-a-long-random-password@127.0.0.1:54329/rescueproof
REDIS_URL=redis://127.0.0.1:63799
BIND_ADDRESS=127.0.0.1:3000
PUBLIC_ORIGIN=http://localhost:5173
SITE_ADDRESS=example.org
COOKIE_SECURE=false
TRUST_PROXY=false
REDIS_NAMESPACE=rescueproof
RUST_LOG=rescueproof=info,tower_http=info
# Empty = evidence stays pending; never fabricate an on-chain confirmation.
# Optional Base Sepolia demo. Leave all ANCHOR_* values empty until configured together.
ANCHOR_RELAYER_URL=
ANCHOR_RELAYER_TOKEN=
ANCHOR_CHAIN_ID=
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_RPC_URL=
RELAYER_PRIVATE_KEY=
