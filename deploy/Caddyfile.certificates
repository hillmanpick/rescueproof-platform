{
    auto_https disable_redirects
    default_sni {$SITE_ADDRESS}
    http_port 80
    https_port 8443
}

https://{$SITE_ADDRESS}:8443 {
    tls {
        key_type rsa2048
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
            disable_tlsalpn_challenge
        }
    }
    respond 404
}

http://{$SITE_ADDRESS} {
    respond 404
}
